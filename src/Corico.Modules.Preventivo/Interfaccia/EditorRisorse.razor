@* Elenco modificabile di risorse (sez. 13.2), usato nelle voci d'offerta (livello analitico) e nelle analisi aziendali. *@
@typeparam TRisorsa where TRisorsa : Corico.Core.Dominio.EntitaBase, IRisorsa, new()

<table class="tabella risorse">
    <thead>
        <tr>
            <th>Categoria</th><th>Descrizione</th><th>U.M.</th>
            <th class="num" title="Quantità di risorsa per unità della lavorazione">Fabbisogno / @(UnitaLavorazione ?? "unità")</th>
            <th class="num">Sfrido %</th><th class="num">Prezzo</th><th class="num">Costo / @(UnitaLavorazione ?? "unità")</th>
            <th>Fonte</th><th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Risorse)
        {
            <tr>
                <td>
                    <select @bind="r.Categoria">
                        @foreach (var c in Enum.GetValues<CategoriaRisorsa>()) { <option value="@c">@Testi.Categoria(c)</option> }
                    </select>
                </td>
                <td><input @bind="r.Descrizione" style="min-width:14rem" class="@(string.IsNullOrWhiteSpace(r.Descrizione) ? "campo-errato" : "")" /></td>
                <td><input @bind="r.Unita" style="width:4rem" /></td>
                <td class="num"><input type="number" step="any" min="0" class="compatto" @bind="r.Fabbisogno" @bind:after="Cambiato" /></td>
                <td class="num"><input type="number" step="any" min="0" class="compatto" @bind="r.SfridoPercentuale" @bind:after="Cambiato" /></td>
                <td class="num"><input type="number" step="any" min="0" class="compatto" @bind="r.Prezzo" @bind:after="Cambiato" /></td>
                <td class="num">@Formato.Numero(Corico.Modules.Preventivo.Dominio.Risorse.CostoUnitario(r), 4)</td>
                <td><input @bind="r.Fonte" style="width:9rem" placeholder="listino, offerta…" /></td>
                <td><button class="pulsante piccolo" @onclick="() => Rimuovi(r)" title="Elimina">✕</button></td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="6">
                <button class="pulsante piccolo" @onclick="Aggiungi">Aggiungi risorsa</button>
                Costo unitario della lavorazione
            </td>
            <td class="num">@Formato.Numero(Risorse.Sum(Corico.Modules.Preventivo.Dominio.Risorse.CostoUnitario), 4)</td>
            <td colspan="2"></td>
        </tr>
    </tfoot>
</table>

@code {
    [Parameter, EditorRequired] public List<TRisorsa> Risorse { get; set; } = [];
    [Parameter] public string? UnitaLavorazione { get; set; }
    [Parameter] public Action<TRisorsa>? Prepara { get; set; }
    [Parameter] public EventCallback OnCambiato { get; set; }

    private async Task Aggiungi()
    {
        var r = new TRisorsa { Id = Guid.Empty, Categoria = Risorse.LastOrDefault()?.Categoria ?? CategoriaRisorsa.Materiali };
        Prepara?.Invoke(r);
        Risorse.Add(r);
        await OnCambiato.InvokeAsync();
    }

    private async Task Rimuovi(TRisorsa r)
    {
        Risorse.Remove(r);
        await OnCambiato.InvokeAsync();
    }

    private Task Cambiato() => OnCambiato.InvokeAsync();
}
