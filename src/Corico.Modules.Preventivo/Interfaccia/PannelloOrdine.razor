@* Ordini di acquisto del pacchetto (Modulo 2, rilascio 2A): avanzamento, preparazione della bozza dall'offerta scelta, elenco degli ordini. *@
@inject OrdiniService Ordini
@inject ListaSpesaService ListaSpesa
@inject SessioneUtente Sessione

@if (_aperto is { } aperto)
{
    <EditorOrdine CommessaId="CommessaId" OrdineId="aperto" OnChiuso="ChiudiAsync" />
    return;
}

<div class="riquadro">
    <div class="riga-form">
        <h3 class="spazio">Ordini di acquisto</h3>
        @if (!Sessione.SolaConsultazione && !(_avanzamento?.TuttoOrdinato ?? false))
        {
            <button class="pulsante primario" disabled="@_occupato" @onclick="PreparaAsync">Prepara ordine…</button>
        }
    </div>

    @if (!string.IsNullOrEmpty(_messaggio))
    {
        <div class="messaggio @(_errore ? "messaggio-errore" : "messaggio-ok")" role="status">
            @_messaggio
            <button type="button" class="chiudi" @onclick="() => _messaggio = null" aria-label="Chiudi">✕</button>
        </div>
    }

    @if (_avanzamento is { HaOrdini: true } a)
    {
        <p>
            Ordinato il <strong>@Formato.Percento(a.PercentualeOrdinata)</strong> del pianificato:
            ordini emessi @Formato.Euro(a.ImportoOrdinato), da ordinare @Formato.Euro(a.Residuo) ai prezzi pianificati.
            Costo attuale @Formato.Euro(a.CostoAttuale) contro @Formato.Euro(a.CostoPianificato) dell'offerta scelta.
            @(a.TuttoOrdinato ? "Tutte le righe sono ordinate: il costo del pacchetto è Definitivo." : "Il costo resta Provvisorio finché tutte le righe non sono ordinate.")
        </p>
    }
    else
    {
        <p class="testo-secondario">
            Nessun ordine emesso. «Prepara ordine» crea una bozza con tutto ciò che resta da ordinare del pacchetto, dal fornitore dell'offerta scelta
            (per una stima interna il fornitore si sceglie nella bozza). Per ordinare solo alcune righe, o righe di più pacchetti, usa la Lista della Spesa.
        </p>
    }

    @if (_ordini.Count > 0)
    {
        <table class="tabella">
            <thead><tr><th>Numero</th><th>Data</th><th>Fornitore</th><th>Stato</th><th class="num">Totale</th><th></th></tr></thead>
            <tbody>
                @foreach (var o in _ordini)
                {
                    <tr class="@(o.Stato == StatoOrdine.Annullato ? "testo-secondario" : "")">
                        <td class="nowrap"><strong>@o.NumeroVisibile</strong></td>
                        <td>@Formato.Data(o.Data)</td>
                        <td>@o.Fornitore</td>
                        <td>
                            <span class="etichetta etichetta-ordine-@o.Stato.ToString().ToLowerInvariant()">@Testi.StatoOrdine(o.Stato)</span>
                            @if (o.Stato == StatoOrdine.Annullato) { <span> @o.MotivoAnnullamento</span> }
                        </td>
                        <td class="num">@Formato.Euro(o.Totale)</td>
                        <td class="nowrap">
                            <button class="pulsante piccolo" @onclick="() => _aperto = o.Id">Apri</button>
                            <a class="pulsante piccolo" href="@($"preventivo/{CommessaId}/ordini/{o.Id}.pdf")" target="_blank">PDF</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="testo-secondario">Un ordine emesso si annulla dalla scheda Ordini, indicando il motivo: le sue quantità tornano «da ordinare».</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid CommessaId { get; set; }
    [Parameter, EditorRequired] public Guid PacchettoId { get; set; }

    /// <summary>Cambia quando cambiano pacchetto o offerta scelta: l'avanzamento va ricalcolato.</summary>
    [Parameter] public string? Chiave { get; set; }

    [Parameter] public EventCallback OnCambiato { get; set; }

    private IReadOnlyList<OrdineAcquisto> _ordini = [];
    private AvanzamentoPacchetto? _avanzamento;
    private Guid? _aperto;
    private string? _chiave, _messaggio;
    private bool _errore, _occupato;

    protected override async Task OnParametersSetAsync()
    {
        if (_chiave == Chiave && _chiave is not null) return;
        _chiave = Chiave;
        await CaricaAsync();
    }

    private async Task CaricaAsync()
    {
        _ordini = await Ordini.PerPacchettoAsync(CommessaId, PacchettoId);
        _avanzamento = (await ListaSpesa.CalcolaAsync(CommessaId)).Pacchetti.GetValueOrDefault(PacchettoId);
    }

    private async Task PreparaAsync()
    {
        _occupato = true;
        try
        {
            _aperto = await Ordini.PreparaDaPacchettoAsync(CommessaId, PacchettoId);
            _messaggio = null;
        }
        catch (OperazioneNonValidaException ex)
        {
            (_messaggio, _errore) = (ex.Message, true);
        }
        finally
        {
            _occupato = false;
        }
    }

    private async Task ChiudiAsync()
    {
        _aperto = null;
        await CaricaAsync();
        await OnCambiato.InvokeAsync();
    }
}
