@* Scheda "Budget" della commessa (rilascio 1C, Modulo 2 2A): proposta e approvazione del budget, versioni immutabili e confronto. *@
@inject ConflittiService Conflitti
@inject VersioniService Versioni
@inject RiepilogoService Riepilogo
@inject BudgetService Budget
@inject SessioneUtente Sessione

@if (!string.IsNullOrEmpty(_messaggio))
{
    <div class="messaggio @(_errore ? "messaggio-errore" : "messaggio-ok")" role="status">
        @_messaggio
        <button type="button" class="chiudi" @onclick="() => _messaggio = null" aria-label="Chiudi">✕</button>
    </div>
}

@if (_versioni is null || _bozza is null || _stato is null)
{
    <p class="testo-secondario">Caricamento…</p>
    return;
}

<div class="riquadro">
    <h3>Budget della commessa</h3>
    <p class="testo-secondario">
        Quando computo, pacchetti e Lista della Spesa sono completi proponi il Budget 0: Corico ne salva una fotografia immutabile
        (ricavi, costi, pacchetti, offerte scelte, spese generali). L'amministratore lo approva oppure lo respinge con un motivo.
        Dopo l'approvazione i prezzi contrattuali sono bloccati e ordini e variazioni si misurano come scostamento dal budget.
        Un nuovo budget (1, 2…) nasce solo da una perizia di variante.
    </p>

    @if (_stato.Approvato is { } ap)
    {
        <div class="blocco-budget">
            <strong>@BudgetService.Etichetta(ap)</strong> da @ap.EsitoDa il @Formato.DataOra(ap.EsitoIl ?? ap.CreatoIl)
            (proposto da @ap.CreatoDa il @Formato.DataOra(ap.CreatoIl)): ricavo @Formato.Euro(ap.Ricavo), costo @Formato.Euro(ap.Costo),
            risultato @Formato.Euro(ap.Risultato). I prezzi contrattuali del computo sono bloccati.
        </div>
    }

    @if (_stato.InApprovazione is { } ia)
    {
        <div class="segnalazione segnalazione-attenzione">
            <strong>@BudgetService.Etichetta(ia)</strong>: proposto da @ia.CreatoDa il @Formato.DataOra(ia.CreatoIl) –
            ricavo @Formato.Euro(ia.Ricavo), costo @Formato.Euro(ia.Costo), MDC @Formato.Euro(ia.Mdc), risultato @Formato.Euro(ia.Risultato).
            @if (ia.Avvisi is { } av)
            {
                <div>Avvisi alla proposta: @av.Replace("\n", " · ")</div>
            }
        </div>
        @if (Sessione.Amministratore)
        {
            <div class="riga-form">
                <button class="pulsante primario" disabled="@_inCorso" @onclick="() => ApprovaAsync(ia.Id)">Approva il Budget @ia.NumeroBudget</button>
                <input class="largo" placeholder="Motivo del rifiuto (obbligatorio per respingere)" @bind="_motivo" @bind:event="oninput" />
                <button class="pulsante pericolo" disabled="@(_inCorso || string.IsNullOrWhiteSpace(_motivo))" @onclick="() => RespingiAsync(ia.Id)">Respingi</button>
            </div>
            <p class="testo-secondario">Dopo l'approvazione il budget non si modifica più. Se lo respingi, la fotografia resta nello storico e si torna a lavorare sulla bozza.</p>
        }
        else
        {
            <p class="testo-secondario">L'approvazione spetta all'amministratore.</p>
        }
    }
    else if (_stato.MotivoNonProponibile is null)
    {
        <h4>Controlli prima della proposta del Budget @_stato.ProssimoNumero</h4>
        <ul class="controlli">
            @foreach (var c in _stato.Controlli)
            {
                <li>
                    <span class="@(c.Superato ? "esito-ok" : c.Bloccante ? "esito-ko" : "esito-avviso")">@(c.Superato ? "✓" : c.Bloccante ? "✕" : "!")</span>
                    @c.Descrizione
                    @if (!c.Superato && !c.Bloccante) { <span class="testo-secondario"> (solo avviso, riportato nella nota del budget)</span> }
                    @if (c.Dettagli.Count > 0 && !c.Superato)
                    {
                        <ul>@foreach (var d in c.Dettagli) { <li>@d</li> }</ul>
                    }
                </li>
            }
        </ul>
        <p>
            Il Budget @_stato.ProssimoNumero conterrà: ricavo @Formato.Euro(_bozza.Totali.Ricavo), costo @Formato.Euro(_bozza.Totali.Costo),
            MDC @Formato.Euro(_bozza.Totali.Mdc), risultato @Formato.Euro(_bozza.Totali.Risultato).
        </p>
        @if (!Sessione.SolaConsultazione)
        {
            <div class="griglia-form due-colonne">
                <label class="largo">
                    Nota (facoltativa)
                    <textarea rows="2" @bind="_nota" placeholder="Es. Budget di avvio lavori dopo l'aggiudicazione"></textarea>
                </label>
            </div>
            <div class="azioni">
                @if (!_conferma)
                {
                    <button class="pulsante primario" disabled="@(!_stato.Proponibile)" @onclick="() => _conferma = true">Proponi il Budget @_stato.ProssimoNumero</button>
                    @if (!_stato.Proponibile)
                    {
                        <span class="testo-secondario">Correggi i controlli segnati con ✕ per poter proporre il budget.</span>
                    }
                }
                else
                {
                    <span class="testo-differenza">La fotografia del budget non potrà essere modificata. Confermi la proposta?</span>
                    <button class="pulsante primario" disabled="@_inCorso" @onclick="ProponiAsync">Conferma proposta</button>
                    <button class="pulsante" @onclick="() => _conferma = false">Annulla</button>
                }
            </div>
        }
    }
    else if (_stato.Approvato is null)
    {
        <p class="testo-secondario">@_stato.MotivoNonProponibile</p>
    }
</div>

<div class="riquadro">
    <h3>Budget e versioni</h3>
    @if (_versioni.Count == 0)
    {
        <p class="testo-secondario">Nessun budget proposto.</p>
    }
    else
    {
        <div class="scorrevole">
            <table class="tabella">
                <thead>
                    <tr>
                        <th>Budget</th><th>Stato</th><th>Proposto</th><th>Esito</th><th>Nota</th>
                        <th class="num">Ricavo</th><th class="num">Costo</th><th class="num">MDC</th>
                        <th class="num">Spese generali</th><th class="num">Risultato</th><th>Stampe</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in _versioni)
                    {
                        <tr class="@(v.StatoBudget == StatoBudget.Respinto ? "testo-secondario" : "")">
                            <td class="nowrap">@(v.EBudget ? $"Budget {v.NumeroBudget}" : $"Versione storica n. {v.Numero}")</td>
                            <td>
                                @if (v.StatoBudget is { } sb)
                                {
                                    <span class="etichetta etichetta-budget-@sb.ToString().ToLowerInvariant()">@Testi.StatoBudget(sb)</span>
                                }
                            </td>
                            <td>@Formato.DataOra(v.CreatoIl)<div class="testo-secondario">@v.CreatoDa</div></td>
                            <td>
                                @if (v.EsitoIl is { } il)
                                {
                                    @Formato.DataOra(il)<div class="testo-secondario">@v.EsitoDa</div>
                                }
                                @if (v.MotivoRifiuto is { } m) { <div>@m</div> }
                            </td>
                            <td>@v.Nota</td>
                            <td class="num">@Formato.Euro(v.Ricavo)</td>
                            <td class="num">@Formato.Euro(v.Costo)</td>
                            <td class="num">@Formato.Euro(v.Mdc)</td>
                            <td class="num">@Formato.Euro(v.SpeseGenerali)</td>
                            <td class="num @(v.Risultato < 0 ? "testo-negativo" : "")">@Formato.Euro(v.Risultato)</td>
                            <td class="azioni-riga">
                                <a class="pulsante piccolo" href="@($"preventivo/{CommessaId}/riepilogo.pdf?versione={v.Id}")" target="_blank">PDF</a>
                                <a class="pulsante piccolo" href="@($"preventivo/{CommessaId}/riepilogo.xlsx?versione={v.Id}")" download>Excel</a>
                                <a class="pulsante piccolo" href="@($"preventivo/{CommessaId}/computo.xlsx?versione={v.Id}")" download>Computo</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_stato.VersioniStoriche.Count > 0)
        {
            <p class="testo-secondario">Le versioni storiche sono quelle pubblicate prima del Modulo 2: restano consultabili e confrontabili, ma non sono budget.</p>
        }
    }
</div>

@if (_versioni.Count > 0)
{
    <div class="riquadro">
        <h3>Confronto</h3>
        <div class="riga-form">
            <label>
                Da
                <select @bind="_primaScelta">
                    @foreach (var v in _versioni) { <option value="@v.Id">@VersioniService.Etichetta(v)</option> }
                    <option value="@Guid.Empty">@VersioniService.EtichettaBozza</option>
                </select>
            </label>
            <label>
                A
                <select @bind="_dopoScelta">
                    <option value="@Guid.Empty">@VersioniService.EtichettaBozza</option>
                    @foreach (var v in _versioni) { <option value="@v.Id">@VersioniService.Etichetta(v)</option> }
                </select>
            </label>
            <button class="pulsante primario" @onclick="ConfrontaAsync">Confronta</button>
        </div>

        @if (_confronto is { } c)
        {
            <h4>@c.EtichettaPrima → @c.EtichettaDopo</h4>
            @if (c.NessunaDifferenza)
            {
                <p class="testo-secondario">Nessuna differenza.</p>
            }
            else
            {
                <TabellaTotaliConfronto Confronto="c" />

                @if (c.Pacchetti.Count > 0)
                {
                    <h4>Pacchetti cambiati (@c.Pacchetti.Count)</h4>
                    <div class="scorrevole">
                        <table class="tabella">
                            <thead>
                                <tr>
                                    <th>Pacchetto</th><th>Esito</th><th>Fornitore</th><th>Stato</th>
                                    <th class="num">Ricavo prima</th><th class="num">Ricavo dopo</th>
                                    <th class="num">Costo prima</th><th class="num">Costo dopo</th>
                                    <th class="num">Differenza MDC</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in c.Pacchetti)
                                {
                                    <tr class="esito-@p.Esito.ToString().ToLowerInvariant()">
                                        <td>@p.Descrizione</td>
                                        <td>@Testi.Esito(p.Esito)</td>
                                        <td>@Cambio(p.FornitorePrima, p.FornitoreDopo)</td>
                                        <td>@Cambio(p.StatoPrima is { } sp ? Testi.Stato(sp) : null, p.StatoDopo is { } sd ? Testi.Stato(sd) : null)</td>
                                        <td class="num">@Importo(p.RicavoPrima)</td>
                                        <td class="num">@Importo(p.RicavoDopo)</td>
                                        <td class="num">@Importo(p.CostoPrima)</td>
                                        <td class="num">@Importo(p.CostoDopo)</td>
                                        <td class="num">@Importo((p.MdcDopo ?? 0) - (p.MdcPrima ?? 0))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (c.Voci.Count > 0)
                {
                    <h4>Voci del computo cambiate (@c.Voci.Count)</h4>
                    <div class="scorrevole">
                        <table class="tabella">
                            <thead>
                                <tr>
                                    <th>Tariffa</th><th>Descrizione</th><th>Esito</th>
                                    <th class="num">Quantità prima</th><th class="num">Quantità dopo</th>
                                    <th class="num">Prezzo prima</th><th class="num">Prezzo dopo</th>
                                    <th class="num">Differenza ricavo netto</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in c.Voci.Take(MassimoVoci))
                                {
                                    <tr class="esito-@v.Esito.ToString().ToLowerInvariant()">
                                        <td class="codice">@v.Tariffa</td>
                                        <td class="descrizione-breve">@v.Descrizione</td>
                                        <td>@Testi.Esito(v.Esito)</td>
                                        <td class="num">@(v.QuantitaPrima is null ? "" : Formato.Numero(v.QuantitaPrima))</td>
                                        <td class="num">@(v.QuantitaDopo is null ? "" : Formato.Numero(v.QuantitaDopo))</td>
                                        <td class="num">@Importo(v.PrezzoPrima)</td>
                                        <td class="num">@Importo(v.PrezzoDopo)</td>
                                        <td class="num">@Importo((v.NettoDopo ?? 0) - (v.NettoPrima ?? 0))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (c.Voci.Count > MassimoVoci)
                    {
                        <p class="testo-secondario">Sono mostrate le prime @MassimoVoci voci su @c.Voci.Count.</p>
                    }
                }
            }
        }
    </div>
}

@code {
    private const int MassimoVoci = 300;

    [Parameter] public Guid CommessaId { get; set; }

    private IReadOnlyList<VersionePreventivo>? _versioni;
    private StatoBudgetCommessa? _stato;
    private Fotografia? _bozza;
    private Confronto? _confronto;
    private string? _nota, _motivo;
    private bool _conferma;
    private bool _inCorso;
    private Guid _primaScelta;
    private Guid _dopoScelta;
    private string? _messaggio;
    private bool _errore;

    protected override Task OnParametersSetAsync() => AggiornaAsync();

    private async Task AggiornaAsync()
    {
        _versioni = await Versioni.ElencoAsync(CommessaId);
        _stato = await Budget.StatoAsync(CommessaId);
        _bozza = await Riepilogo.FotografiaAsync(CommessaId);
        _primaScelta = _versioni.FirstOrDefault()?.Id ?? Guid.Empty;
        _dopoScelta = Guid.Empty;
    }

    private Task ProponiAsync() => EseguiAsync(async () =>
    {
        var v = await Budget.ProponiAsync(CommessaId, _nota);
        (_nota, _conferma, _confronto) = (null, false, null);
        return $"Budget {v.NumeroBudget} proposto per l'approvazione.";
    });

    private Task ApprovaAsync(Guid id) => EseguiAsync(async () =>
    {
        await Budget.ApprovaAsync(CommessaId, id);
        return "Budget approvato: da ora i prezzi contrattuali sono bloccati e il tabellone mostra lo scostamento dal budget.";
    });

    private Task RespingiAsync(Guid id) => EseguiAsync(async () =>
    {
        await Budget.RespingiAsync(CommessaId, id, _motivo ?? "");
        _motivo = null;
        return "Budget respinto: puoi correggere la bozza e proporlo di nuovo.";
    });

    private async Task EseguiAsync(Func<Task<string>> operazione)
    {
        _inCorso = true;
        try
        {
            (_messaggio, _errore) = (await operazione(), false);
            await AggiornaAsync();
        }
        catch (ConflittoModificaException c)
        {
            Conflitti.Mostra(c, null, AggiornaAsync);
        }
        catch (Exception ex) when (ex is OperazioneNonValidaException or ConflittoModificaException)
        {
            (_messaggio, _errore) = (ex.Message, true);
        }
        finally
        {
            _inCorso = false;
        }
    }

    private async Task ConfrontaAsync()
    {
        try
        {
            _confronto = await Versioni.ConfrontaAsync(CommessaId, Id(_primaScelta), Id(_dopoScelta));
        }
        catch (OperazioneNonValidaException ex)
        {
            (_messaggio, _errore) = (ex.Message, true);
        }
    }

    private static Guid? Id(Guid g) => g == Guid.Empty ? null : g;

    private static string Importo(decimal? v) => v is null ? "" : Formato.Euro(v);

    private static string Cambio(string? prima, string? dopo) =>
        prima == dopo ? prima ?? "" : $"{prima ?? "—"} → {dopo ?? "—"}";
}
