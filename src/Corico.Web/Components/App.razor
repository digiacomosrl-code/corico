<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Corico.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" href="data:," />
    <HeadOutlet @rendermode="ModalitaPagina" />
</head>

<body>
    <Routes @rendermode="ModalitaPagina" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // La pagina di accesso è statica (imposta il cookie); tutte le altre sono interattive.
    private IComponentRenderMode? ModalitaPagina =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
