@page "/password"
@inject UtentiService Utenti
@inject SessioneUtente Sessione
@inject NavigationManager Nav

<PageTitle>Cambio password — Corico</PageTitle>

<h1>Cambio password</h1>
@if (Sessione.Identita?.CambioPasswordObbligatorio == true)
{
    <p>È il tuo primo accesso o l'amministratore ha reimpostato la password: scegline una personale per continuare.</p>
}

<Messaggio Testo="@_messaggio" Errore="_errore" OnChiudi="() => _messaggio = null" />

<div class="riquadro modulo-stretto">
    <label>Password attuale (o provvisoria) <input type="password" @bind="_attuale" autocomplete="current-password" /></label>
    <label>Nuova password (almeno 8 caratteri, con lettere e numeri) <input type="password" @bind="_nuova" autocomplete="new-password" /></label>
    <label>Ripeti la nuova password <input type="password" @bind="_conferma" autocomplete="new-password" /></label>
    <div class="azioni">
        <button class="pulsante primario" @onclick="CambiaAsync">Cambia password</button>
    </div>
</div>

@code {
    private string? _attuale, _nuova, _conferma, _messaggio;
    private bool _errore;

    private async Task CambiaAsync()
    {
        if (Sessione.Identita is not { } u) return;
        if (_nuova != _conferma)
        {
            (_messaggio, _errore) = ("Le due password nuove non coincidono.", true);
            return;
        }
        try
        {
            var obbligatorio = u.CambioPasswordObbligatorio;
            await Utenti.CambiaPasswordAsync(u.Id, _attuale ?? "", _nuova ?? "");
            Sessione.Identita = await Utenti.IdentitaAsync(u.Id);
            (_attuale, _nuova, _conferma) = (null, null, null);
            if (obbligatorio) Nav.NavigateTo("", forceLoad: true);
            else (_messaggio, _errore) = ("Password cambiata.", false);
        }
        catch (OperazioneNonValidaException ex)
        {
            (_messaggio, _errore) = (ex.Message, true);
        }
    }
}
