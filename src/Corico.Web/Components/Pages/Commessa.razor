@page "/commesse/{Id:guid}"
@inject CommesseService Commesse
@inject RegistroModuli Moduli
@inject PresenzaService Presenza
@inject StoricoService Storico
@inject SessioneUtente Sessione
@implements IDisposable

<PageTitle>@(_commessa?.Codice ?? "Commessa") — Corico</PageTitle>

@if (_commessa is null)
{
    <p>@(_caricata ? "Commessa non trovata." : "Caricamento…")</p>
}
else
{
    <div class="intestazione">
        <div>
            <div class="testo-secondario"><a href="">Commesse</a> › @_commessa.Codice</div>
            <h1>@_commessa.Codice — @_commessa.Descrizione</h1>
            @if (_ultima is { } u)
            {
                <div class="ultima-modifica">@Formato.UltimaModifica(u.Utente, u.DataOra)</div>
            }
        </div>
        <div><EtichettaStato Stato="_commessa.Stato" Archiviata="_commessa.Archiviata" /></div>
    </div>

    @if (_altri.Count > 0)
    {
        <div class="presenza" role="status">
            Anche @string.Join(", ", _altri) @(_altri.Count == 1 ? "sta" : "stanno") lavorando su questa commessa.
            Se modificate gli stessi dati, Corico salva la prima modifica e mostra all'altro le differenze prima di sovrascrivere.
        </div>
    }

    <div class="schede" role="tablist">
        @foreach (var titolo in Schede())
        {
            <button role="tab" class="scheda @(titolo == _schedaAttiva ? "attiva" : "")" @onclick="() => CambiaSchedaAsync(titolo)">@titolo</button>
        }
    </div>

    @switch (_schedaAttiva)
    {
        case "Dati generali":
            <DatiGeneraliCommessa Commessa="_commessa" CommessaChanged="c => _commessa = c" />
            break;
        case "Documenti":
            <DocumentiCommessa CommessaId="_commessa.Id" />
            break;
        case "Storico":
            <StoricoCommessa CommessaId="_commessa.Id" OnAnnullato="RicaricaAsync" />
            break;
        default:
            var scheda = Moduli.SchedeCommessa.FirstOrDefault(s => s.Titolo == _schedaAttiva);
            if (scheda is not null)
            {
                <DynamicComponent Type="scheda.Componente" Parameters="@(new Dictionary<string, object> { ["CommessaId"] = _commessa.Id })" />
            }
            break;
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private DatiCommessa? _commessa;
    private bool _caricata;
    private string _schedaAttiva = "Dati generali";

    private IReadOnlyList<string> _altri = [];
    private VoceStorico? _ultima;
    private bool _inAscolto;

    protected override async Task OnParametersSetAsync()
    {
        _commessa = await Commesse.OttieniAsync(Id);
        _ultima = await Storico.UltimaAsync(Id);
        _caricata = true;
        Presenza.ApriCommessa(Sessione.Id, Id);
        if (!_inAscolto) { Presenza.Cambiato += AggiornaPresenze; _inAscolto = true; }
        _altri = AltriUtenti();
    }

    private async Task CambiaSchedaAsync(string titolo)
    {
        _schedaAttiva = titolo;
        _ultima = await Storico.UltimaAsync(Id);
    }

    private IReadOnlyList<string> AltriUtenti() =>
        Sessione.Identita is { } u ? Presenza.AltriSullaCommessa(Id, u.Id) : [];

    private void AggiornaPresenze() => _ = InvokeAsync(() =>
    {
        _altri = AltriUtenti();
        StateHasChanged();
    });

    public void Dispose()
    {
        Presenza.Cambiato -= AggiornaPresenze;
        Presenza.ApriCommessa(Sessione.Id, null);
    }

    /// <summary>Dopo un annullamento dallo storico i dati della commessa possono essere cambiati.</summary>
    private async Task RicaricaAsync() => _commessa = await Commesse.OttieniAsync(Id) ?? _commessa;

    private IEnumerable<string> Schede() =>
        new[] { "Dati generali" }
            .Concat(Moduli.SchedeCommessa.Select(s => s.Titolo))
            .Concat(new[] { "Documenti", "Storico" });
}
