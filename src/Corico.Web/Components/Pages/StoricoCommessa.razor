@using System.Text.Json
@inject ConflittiService Conflitti
@inject StoricoService Storico
@inject AnnullamentoService Annullamento

@if (_voci is null)
{
    <p>Caricamento…</p>
}
else if (_voci.Count == 0)
{
    <div class="vuoto">Nessuna modifica registrata.</div>
}
else
{
    @if (!string.IsNullOrEmpty(_messaggio))
    {
        <div class="messaggio @(_errore ? "messaggio-errore" : "messaggio-ok")" role="status">
            @_messaggio
            <button type="button" class="chiudi" @onclick="() => _messaggio = null" aria-label="Chiudi">✕</button>
        </div>
    }
    <p class="testo-secondario">
        Le modifiche di dati si possono annullare singolarmente con «Annulla…»: prima di ripristinare, Corico mostra i valori attuali
        e quelli da ripristinare. L'annullamento viene registrato a sua volta qui sotto.
    </p>
    <div class="riga-form">
        <label>
            Utente
            <select @bind="_utente">
                <option value="">Tutti</option>
                @foreach (var u in _voci.Select(v => v.Utente).Distinct().Order(StringComparer.CurrentCultureIgnoreCase))
                {
                    <option value="@u">@u</option>
                }
            </select>
        </label>
    </div>
    <table class="tabella">
        <thead>
            <tr><th>Data e ora</th><th>Utente</th><th>Operazione</th><th>Elemento</th><th>Dati modificati</th><th>Nota</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var v in _voci.Where(v => string.IsNullOrEmpty(_utente) || v.Utente == _utente))
            {
                <tr>
                    <td class="nowrap">@Formato.DataOra(v.DataOra)</td>
                    <td>@v.Utente</td>
                    <td>@v.Operazione</td>
                    <td>@v.Entita</td>
                    <td>
                        @foreach (var riga in Differenze(v))
                        {
                            <div>@riga</div>
                        }
                    </td>
                    <td>@v.Nota</td>
                    <td>
                        @if (AnnullamentoService.Annullabile(v))
                        {
                            <button class="pulsante piccolo @(_anteprima?.VoceId == v.Id ? "attivo" : "")" @onclick="() => ApriAsync(v.Id)">Annulla…</button>
                        }
                    </td>
                </tr>
                @if (_anteprima?.VoceId == v.Id)
                {
                    <tr class="dettaglio-annullamento">
                        <td colspan="7">
                            @if (!_anteprima.Possibile)
                            {
                                <div class="segnalazione segnalazione-attenzione">Annullamento non possibile: @_anteprima.Motivo</div>
                                <button class="pulsante piccolo" @onclick="() => _anteprima = null">Chiudi</button>
                            }
                            else
                            {
                                <table class="tabella quadro">
                                    <thead><tr><th>Campo</th><th>Valore attuale</th><th>Valore da ripristinare</th></tr></thead>
                                    <tbody>
                                        @foreach (var c in _anteprima.Campi)
                                        {
                                            <tr>
                                                <td>@c.Campo</td>
                                                <td class="@(c.CambiatoDopo ? "campo-cambiato" : "")">@Testo(c.Campo, c.Attuale)@(c.CambiatoDopo ? " (modificato in seguito)" : "")</td>
                                                <td>@Testo(c.Campo, c.DaRipristinare)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                @if (_anteprima.RichiedeConfermaAggiuntiva)
                                {
                                    <div class="segnalazione segnalazione-attenzione">
                                        Dopo questa operazione alcuni campi sono stati modificati di nuovo: l'annullamento sovrascrive anche quelle modifiche.
                                    </div>
                                }
                                else if (_anteprima.ModificheSuccessive > 0)
                                {
                                    <p class="testo-secondario">Dopo questa operazione l'elemento ha avuto altre @_anteprima.ModificheSuccessive modifiche, su campi diversi: restano invariate.</p>
                                }
                                <div class="azioni-in-linea">
                                    <button class="pulsante primario piccolo" @onclick="AnnullaAsync">Ripristina i valori precedenti</button>
                                    <button class="pulsante piccolo" @onclick="() => _anteprima = null">Chiudi</button>
                                </div>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}

@code {
    private string? _utente;

    [Parameter] public Guid CommessaId { get; set; }
    [Parameter] public EventCallback OnAnnullato { get; set; }
    private IReadOnlyList<VoceStorico>? _voci;
    private AnteprimaAnnullamento? _anteprima;
    private string? _messaggio;
    private bool _errore;

    protected override async Task OnParametersSetAsync() => _voci = await Storico.PerCommessaAsync(CommessaId);

    private async Task ApriAsync(long id) =>
        _anteprima = _anteprima?.VoceId == id ? null : await Annullamento.AnteprimaAsync(id);

    private async Task AnnullaAsync()
    {
        try
        {
            await Annullamento.AnnullaAsync(_anteprima!.VoceId, confermaSovrascrittura: true);
            (_messaggio, _errore) = ("Valori precedenti ripristinati. L'annullamento è registrato nello storico.", false);
            _anteprima = null;
            _voci = await Storico.PerCommessaAsync(CommessaId);
            await OnAnnullato.InvokeAsync();
        }
        catch (ConflittoModificaException c)
        {
            Conflitti.Mostra(c, null, async () => { _anteprima = null; _voci = await Storico.PerCommessaAsync(CommessaId); });
        }
        catch (Exception ex) when (ex is OperazioneNonValidaException or ConflittoModificaException)
        {
            (_messaggio, _errore) = (ex.Message, true);
        }
    }

    /// <summary>Righe leggibili "Campo: prima → dopo"; nei nuovi inserimenti solo i campi compilati.</summary>
    private static IEnumerable<string> Differenze(VoceStorico v)
    {
        var prima = Leggi(v.ValoriPrecedenti);
        var dopo = Leggi(v.ValoriSuccessivi);
        foreach (var campo in prima.Keys.Union(dopo.Keys))
        {
            if (campo == "Id") continue;
            var p = Testo(campo, prima.GetValueOrDefault(campo));
            var d = Testo(campo, dopo.GetValueOrDefault(campo));
            if (v.Operazione == "Inserimento" && d == "—") continue;
            yield return v.Operazione switch
            {
                "Inserimento" => $"{campo}: {d}",
                "Eliminazione" => $"{campo}: {p}",
                _ => $"{campo}: {p} → {d}",
            };
        }
    }

    private static Dictionary<string, JsonElement> Leggi(string? json) =>
        string.IsNullOrEmpty(json) ? [] : JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(json) ?? [];

    private static string Testo(string campo, JsonElement valore)
    {
        if (valore.ValueKind is JsonValueKind.Undefined or JsonValueKind.Null) return "—";
        if (campo == "Stato" && valore.TryGetInt32(out var s)) return EtichettaStato.Testo((StatoCommessa)s);
        if (campo.EndsWith("Id", StringComparison.Ordinal)) return "(collegamento)";
        return valore.ValueKind switch
        {
            JsonValueKind.True => "sì",
            JsonValueKind.False => "no",
            JsonValueKind.Number => valore.GetDecimal().ToString("#,##0.##", Formato.Italiano),
            _ => valore.ToString(),
        };
    }
}
