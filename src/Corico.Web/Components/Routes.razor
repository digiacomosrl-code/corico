@inject RegistroModuli Moduli

<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="_assemblyModuli" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <VaiAdAccesso />
                }
                else
                {
                    <div class="riquadro"><h3>Accesso non consentito</h3><p>Questa pagina è riservata all'amministratore.</p></div>
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    private System.Reflection.Assembly[] _assemblyModuli = [];

    protected override void OnInitialized() =>
        _assemblyModuli = Moduli.Attivi.Select(m => m.AssemblyInterfaccia).Distinct().ToArray();
}
